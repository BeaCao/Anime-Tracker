rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Estadísticas públicas (lectura libre, escritura solo autenticados) ──
    match /publicStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Registro de usuarios (cada usuario solo escribe el suyo) ──────────
    match /registeredUsers/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Lista de animes del usuario (solo el dueño) ───────────────────────
    match /user_animes/{docId} {
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && docId == request.auth.uid + '_' + request.resource.data.malId;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }
  }
}
